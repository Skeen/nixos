{pkgs, ...}: let
  # Internal laptop panel (BOE NE160QDM-NZL), 2560x1600 @ 240Hz
  edp_fingerprint = "";
in {
  # AutoRandr is a smart wrapper around xrandr for handling display configuration
  services.autorandr = {
    enable = true;

    profiles = {
      "office" = {
        # Fingerprints produced using `autorandr --fingerprint`
        fingerprint = {
          # Samsung S24E650, 1920x1080
          "DisplayPort-5" = "";
          # Samsung S24E650, 1920x1080
          "DisplayPort-8" = "";
          # Samsung S24E650, 1920x1080
          "DisplayPort-10" = "";
          "eDP" = edp_fingerprint;
        };
        config = {
          # [ left ][ middle ][ right ][ laptop ]
          # [ DisplayPort-8 ][ DisplayPort-10 ][ DisplayPort-5 ][ eDP ]

          # Left
          "DisplayPort-8" = {
            enable = true;
            position = "0x0";
            mode = "1920x1080";
            rate = "60.00";
          };
          # Middle (primary)
          "DisplayPort-10" = {
            enable = true;
            primary = true;
            position = "1920x0";
            mode = "1920x1080";
            rate = "60.00";
          };
          # Right
          "DisplayPort-5" = {
            enable = true;
            position = "3840x0";
            mode = "1920x1080";
            rate = "60.00";
          };
          # Laptop panel, far right.
          # Kept at 60Hz to match the externals; mixing 240Hz here with the
          # 60Hz externals causes compositor micro-stutter under X11/XFCE,
          # which only vsyncs to a single output's vblank.
          "eDP" = {
            enable = true;
            position = "5760x0";
            mode = "2560x1600";
            rate = "60.00";
          };
        };
      };

      # Fallback when no externals are attached: laptop panel only, at its
      # full 240Hz. Matches because eDP is then the sole fingerprinted output.
      "default" = {
        fingerprint = {
          "eDP" = edp_fingerprint;
        };
        config = {
          "eDP" = {
            enable = true;
            primary = true;
            position = "0x0";
            mode = "2560x1600";
            rate = "240.00";
          };
        };
      };
    };
  };

  environment.systemPackages = [ pkgs.autorandr ];
}
